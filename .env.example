# ─────────────────────────────────────────────────────────────
# QuickChat Frontend — variables de entorno
# Copia este archivo a `.env` y rellena los valores.
# Solo variables NEXT_PUBLIC_* (expuestas al navegador): NO pongas secretos
# de servidor aquí.
# ─────────────────────────────────────────────────────────────

# URL del backend (API REST). Ej: http://localhost:3002
NEXT_PUBLIC_API_URL=http://localhost:3002

# URL del WebSocket (Socket.io). Suele ser el mismo host que la API.
# Se acepta http(s):// (el cliente deriva ws(s):// automáticamente).
NEXT_PUBLIC_WS_URL=http://localhost:3002

# API key pública de Giphy (búsqueda de GIFs). https://developers.giphy.com
NEXT_PUBLIC_GIPHY_API_KEY=your-giphy-public-api-key

# Credenciales del servidor TURN para llamadas WebRTC (opcionales en local).
# Obtén credenciales gratis en p.ej. metered.ca / twilio.
NEXT_PUBLIC_TURN_USERNAME=your-turn-username
NEXT_PUBLIC_TURN_CREDENTIAL=your-turn-credential

# Clave de transporte (QCipher). DEBE coincidir EXACTAMENTE con
# CRYPTO_TRANSPORT_KEY del backend. Cambiar en producción (mín. 32 bytes).
NEXT_PUBLIC_CRYPTO_TRANSPORT_KEY=quickchat-transport-default-change-me-in-production-32bytes
